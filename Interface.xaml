<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GameModz" Width="1120" Height="830" MinWidth="940" MinHeight="730" WindowStartupLocation="CenterScreen" Background="#F6F7F9" Foreground="#202125" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#EDF1F6"/><Setter Property="Foreground" Value="#596575"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#737782"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E6EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="16,10"/><Setter Property="Background" Value="#EDEFF3"/><Setter Property="Foreground" Value="#303743"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PowerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,15"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2DA96E" Offset="0"/><GradientStop Color="#208955" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PowerSurface" Background="{TemplateBinding Background}" BorderBrush="#208153" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Grid Width="17" Height="19" Margin="0,0,10,0"><Path x:Name="PowerGlyph" Data="M 5,4 A 7,7 0 1 0 12,4 M 8.5,0 L 8.5,8" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="BusyGlyph" Text="…" FontSize="18" Foreground="White" Visibility="Collapsed" VerticalAlignment="Center"/></Grid><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.65"/><Setter TargetName="PowerGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="BusyGlyph" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="#103F28"/><Setter TargetName="PowerSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#363B44"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,18,0"/><Border x:Name="Track" Grid.Column="1" Background="#D9DCE2" Width="38" Height="23" CornerRadius="12" HorizontalAlignment="Right"><Ellipse x:Name="Thumb" Width="19" Height="19" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3478F6"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#163E88"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EBEDF1" BorderBrush="#DDDFE5" BorderThickness="0,0,1,0"><Grid Margin="18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="GameModz" FontWeight="SemiBold" FontSize="23" Margin="8,0,0,2"/><TextBlock Text="Seu espaço para jogar." Style="{StaticResource Muted}" Margin="8,0,0,32"/><Button x:Name="NavOverview" Content="◉   Visão geral" Style="{StaticResource Navigation}"/><Button x:Name="NavSettings" Content="☷   Preferências" Style="{StaticResource Navigation}"/><Button x:Name="NavChecklist" Content="✓   Checklist" Style="{StaticResource Navigation}"/><Button x:Name="NavResources" Content="▦   Aplicativos" Style="{StaticResource Navigation}"/><Button x:Name="NavIdeas" Content="↗   Melhorias de FPS" Style="{StaticResource Navigation}"/></StackPanel>
   <StackPanel Grid.Row="2" Margin="8,0"><TextBlock Text="FEITO PARA SEU PC" FontSize="9" Foreground="#8A8F9B"/><TextBlock Text="Ajustes reversíveis.&#10;Sem serviços residentes." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,24,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="54"/><RowDefinition Height="146"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
   <DockPanel><Border DockPanel.Dock="Right" Background="#E9EDF3" CornerRadius="10" Padding="10,5" VerticalAlignment="Top"><TextBlock x:Name="Badge" Text="●  Em espera" FontSize="11" Foreground="#677384"/></Border><StackPanel><TextBlock x:Name="PageTitle" Text="Tudo pronto para jogar." FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Prepare o essencial. Depois, volte ao seu normal." Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Headline" Text="Modo de jogo" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="HeroHint" Text="Fundo preto e interface leve. Seus ajustes ficam salvos." Style="{StaticResource Muted}" Margin="0,8,16,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="MainAction" Content="Ativar modo de jogo" Style="{StaticResource PowerAction}" AutomationProperties.Name="Ativar ou restaurar modo de jogo"/><TextBlock x:Name="StateLabel" Text="Restauração manual ao terminar" Foreground="#7E8390" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid></Border>
   <Grid x:Name="PageHost" Grid.Row="2">
    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Menos ruído. Mais controle." FontSize="18" FontWeight="SemiBold" Margin="0,5,0,14"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="◐" FontSize="23" Foreground="#3478F6"/><TextBlock Text="Ambiente leve" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Fundo preto, efeitos reduzidos e transparência desativada durante a sessão." Style="{StaticResource Muted}"/><TextBlock Text="Incluído ao ativar" FontSize="11" Foreground="#21835F" Margin="0,16,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="↶" FontSize="23" Foreground="#3478F6"/><TextBlock Text="Seu normal, de volta" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Restaura as configurações anteriores. O estado salvo permanece após reiniciar." Style="{StaticResource Muted}"/><TextBlock Text="Um botão para restaurar" FontSize="11" Foreground="#21835F" Margin="0,16,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18"><DockPanel><Button x:Name="Explore" DockPanel.Dock="Right" Content="Explorar →" Margin="18,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="5 caminhos para melhorar o desempenho" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Recomendações por compatibilidade. Sem estimativas inventadas de FPS." Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
     <Expander Header="Atividade da sessão" Margin="0,18,0,12" Foreground="#6D7581" IsExpanded="True"><TextBox x:Name="Log" Text="Nenhuma alteração aplicada nesta sessão." IsReadOnly="True" Background="Transparent" Foreground="#697582" BorderThickness="0" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,10,0,0"/></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,4,0,14"><StackPanel><TextBlock Text="Durante a partida" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="Power" Content="Plano de alto desempenho" Visibility="Collapsed"/><TextBlock Text="Brilho e plano de energia preservados" Foreground="#21835F" FontSize="13" Margin="0,9"/><TextBlock Text="O GameModz mantém seu plano atual para evitar mudanças de brilho." Style="{StaticResource Muted}"/><CheckBox x:Name="Sync" Content="Interromper OneDrive"/><TextBlock Text="Retoma ao restaurar, somente se estava em execução." Style="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Aplicativos a fechar" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Salve seu trabalho. Apenas pedidos de fechamento, sem forçar." Style="{StaticResource Muted}" Margin="0,6,0,8"/><CheckBox x:Name="Chrome" Content="Google Chrome"/><CheckBox x:Name="Edge" Content="Microsoft Edge"/><CheckBox x:Name="Discord" Content="Discord"/><CheckBox x:Name="Spotify" Content="Spotify"/><Border Height="1" Background="#ECEEF2" Margin="0,10"/><CheckBox x:Name="Reopen" Content="Reabrir aplicativos ao restaurar" IsChecked="True"/><TextBlock Text="Recuperar abas e documentos depende de cada aplicativo." Style="{StaticResource Muted}"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Interface" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="Motion" Content="Reduzir movimento"/><TextBlock Text="Transições breves, sem animações contínuas durante a partida." Style="{StaticResource Muted}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
        <Grid x:Name="ChecklistPage" Visibility="Collapsed" Margin="0,4,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button x:Name="RetryItem" DockPanel.Dock="Right" Content="Repetir item selecionado" IsEnabled="False"/><TextBlock x:Name="ChecklistHint" Text="Cada etapa mostra o resultado real da operação." Style="{StaticResource Muted}" Margin="0,0,15,0" VerticalAlignment="Center"/></DockPanel>
     <DataGrid x:Name="ChecklistGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderBrush="#E4E6EA" RowBackground="White" AlternatingRowBackground="#F7F9FB" RowHeight="42" FontSize="12" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns><DataGridTextColumn Header="Operação" Binding="{Binding Name}" Width="*" MinWidth="240"/><DataGridTextColumn Header="Fase" Binding="{Binding Phase}" Width="85"/><DataGridTextColumn Header="Resultado" Binding="{Binding Status}" Width="145"/></DataGrid.Columns>
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Falhou"><Setter Property="Foreground" Value="#B33838"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Não respondeu"><Setter Property="Foreground" Value="#996A16"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
     </DataGrid>
     <Border Grid.Row="2" Background="#EAF0FC" CornerRadius="10" Padding="14" Margin="0,12,0,0"><TextBlock x:Name="StepDetail" Text="Selecione uma etapa para ver detalhes. A repetição não refaz as etapas concluídas." Foreground="#53647E" FontSize="12"/></Border>
    </Grid>
    <Grid x:Name="ResourcesPage" Visibility="Collapsed" Margin="0,4,0,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="MonitorHint" Text="Amostras a cada 2 s. Alerta após 3 amostras: CPU ≥ 5% ou RAM ≥ 512 MB. RAM é a soma aproximada do conjunto de trabalho." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
     <DataGrid x:Name="ResourceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="White" BorderBrush="#E4E6EA" RowBackground="White" AlternatingRowBackground="#F7F9FB" RowHeight="42" FontSize="12">
      <DataGrid.Columns><DataGridTextColumn Header="Aplicativo" Binding="{Binding Name}" Width="*" MinWidth="240"/><DataGridTextColumn Header="CPU %" Binding="{Binding Cpu}" Width="70"/><DataGridTextColumn Header="RAM MB" Binding="{Binding Ram}" Width="80"/><DataGridTextColumn Header="Observação" Binding="{Binding Status}" Width="160"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="ResourceDetail" Grid.Row="2" Text="Ative o modo de jogo para usar ações nos aplicativos compatíveis. Nenhum processo é alterado automaticamente." Style="{StaticResource Muted}" Margin="0,12,0,10"/>
     <WrapPanel Grid.Row="3"><Button x:Name="LowerPriority" Content="Reduzir prioridade" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="CloseSelectedApp" Content="Solicitar fechamento" IsEnabled="False"/></WrapPanel>
    </Grid>

    <ScrollViewer x:Name="IdeasPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="IdeasList" Margin="0,4,0,12"><Border Background="#EAF0FC" CornerRadius="12" Padding="15" Margin="0,0,0,14"><TextBlock Text="Recomendações guiadas • As opções abaixo não são aplicadas pelo botão principal. Ajustes feitos no Windows ou no jogo devem ser revertidos nesses locais." Foreground="#53647E" FontSize="12"/></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#DFE3E9" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="PROCESSADOR" FontSize="9" Foreground="#9196A1"/><TextBlock x:Name="CpuInfo" Text="Detectando…" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="GRÁFICOS" FontSize="9" Foreground="#9196A1"/><TextBlock x:Name="GpuInfo" Text="Detectando…" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="MEMÓRIA / SISTEMA" FontSize="9" Foreground="#9196A1"/><TextBlock x:Name="RamInfo" Text="Detectando…" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
